# ==============================================================================
# Standalone Real-Time CCTV Activity & Risk Intelligence Backend (.env.example)
# Copy to .env and adjust for your environment. Never commit real secrets.
# ==============================================================================

# 1. Core Service & Model Configuration
AI_BACKEND_HOST=0.0.0.0
AI_BACKEND_PORT=8081
AI_DEVICE=auto
AI_MODEL_PATH=models/yolov8n-pose.onnx
AI_LOG_LEVEL=INFO
OMP_NUM_THREADS=2

# 2. Optional IURIS Outbound HTTP Event Delivery
# Set IURIS_DRY_RUN=true to validate and record outbound events locally without network calls.
IURIS_DELIVERY_ENABLED=false
IURIS_DRY_RUN=false
IURIS_BASE_URL=
IURIS_EVENTS_PATH=/api/v1/cctv/events
IURIS_API_TOKEN=

# 3. Outbound Event Queue & Retry Backpressure
EVENT_QUEUE_MAX_SIZE=1000
EVENT_RETRY_MAX_ATTEMPTS=8

# 4. Activity & Summary Window Configuration
ACTIVITY_WINDOW_SECONDS=10
ACTIVITY_MIN_CONFIDENCE=0.50

# 5. Independent Risk Assessment Rules
RISK_RULES_PATH=config/risk_rules.yaml
